#!/usr/bin/env bash
# Git pre-commit hook for m3u8dl.
#
# Runs a set of lightweight checks before each commit to keep the codebase
# consistent regardless of contributor's editor/OS settings:
#   - gofmt (Go formatting, tabs)
#   - go vet (static analysis)
#   - end-of-file newline check
#   - trailing whitespace check
#   - mixed line-ending check (LF only)
#
# Install with:   make install-hooks    (or: hooks/install.sh)
#
# Set SKIP=1 to bypass:   SKIP=1 git commit ...
set -euo pipefail

# Change into the git working tree root.
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ "${SKIP:-}" = "1" ]; then
  echo "[pre-commit] SKIP=1, skipping checks."
  exit 0
fi

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; NC='\033[0m'
fail() { echo -e "${RED}[pre-commit] FAIL: $*${NC}"; exit 1; }
ok()   { echo -e "${GREEN}[pre-commit] OK: $*${NC}"; }

echo -e "${YELLOW}[pre-commit] Running m3u8dl commit checks...${NC}"

# ---------------------------------------------------------------------------
# 1. gofmt: fail on unformatted Go files, but try to auto-format them first.
# ---------------------------------------------------------------------------
if command -v go >/dev/null 2>&1; then
  unformatted="$(gofmt -l . 2>/dev/null || true)"
  if [ -n "$unformatted" ]; then
    echo -e "${YELLOW}[pre-commit] gofmt: formatting files automatically...${NC}"
    gofmt -w .
  fi
  # Re-check after formatting.
  unformatted_after="$(gofmt -l . 2>/dev/null || true)"
  if [ -n "$unformatted_after" ]; then
    fail "gofmt: the following files are not formatted:\n$unformatted_after"
  fi
  ok "gofmt"
else
  echo -e "${YELLOW}[pre-commit] go not found, skipping gofmt/go vet.${NC}"
fi

# ---------------------------------------------------------------------------
# 2. go vet
# ---------------------------------------------------------------------------
if command -v go >/dev/null 2>&1 && [ -f go.mod ]; then
  go vet ./... || fail "go vet reported issues."
  ok "go vet"
fi

# ---------------------------------------------------------------------------
# 3. Files staged for commit (excluding generated/vendored/blob dirs).
#    For each staged text file:
#      - ensure exactly one trailing newline
#      - reject trailing whitespace
#      - reject CRLF (enforce LF)
# ---------------------------------------------------------------------------
STAGED=$(git diff --cached --name-only --diff-filter=ACM \
          -- ':!bin' ':!dist' ':!*.mp4' ':!*.ts' ':!*.part')
if [ -n "$STAGED" ]; then
  lf_fix_any=0
  for file in $STAGED; do
    [ -f "$file" ] || continue
    # Skip binary-ish files (detect NUL).
    if grep -qP '\x00' "$file" 2>/dev/null; then
      continue
    fi
    # a) Enforce LF line endings.
    if grep -q $'\r\n' "$file" 2>/dev/null; then
      perl -pi -e 's/\r\n/\n/g' "$file"
      echo -e "${YELLOW}  [fix] $file: CRLF -> LF${NC}"
      lf_fix_any=1
    fi
    # b) Ensure exactly one trailing newline.
    if [ -n "$(tail -c 1 "$file" 2>/dev/null)" ]; then
      # last byte is not a newline; append one.
      printf '\n' >> "$file"
      echo -e "${YELLOW}  [fix] $file: added missing EOF newline${NC}"
      lf_fix_any=1
    fi
    # c) Reject trailing whitespace.
    if grep -nE ' +$|\t+$' "$file" >/dev/null 2>&1; then
      fail "trailing whitespace in '$file'. Run 'make style' or fix manually:\n$(grep -nE ' +$|\t+$' "$file" | head)\n"
    fi
  done
  if [ "$lf_fix_any" = "1" ]; then
    echo -e "${YELLOW}[pre-commit] Auto-fixes applied (LF / EOF newline). Re-stage changed files:${NC}"
    echo "    git add -A && git commit --no-verify  # or just re-add and commit"
    git add -u
    ok "EOF newline / line-ending auto-fix"
  fi
  ok "staged text files clean"
else
  ok "no staged text files to check"
fi

echo -e "${GREEN}[pre-commit] All checks passed.${NC}"
exit 0
